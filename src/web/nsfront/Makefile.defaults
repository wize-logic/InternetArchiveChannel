# -*- mode: makefile-gmake -*-
# Wii build: no curl/OpenSSL (the app's own mbedTLS fetcher plugs in later), no JavaScript,
# GIF/BMP/PNG/JPEG (tools/build-deps.sh images), built-in bitmap font.
NETSURF_USE_CURL := NO
NETSURF_USE_OPENSSL := NO
NETSURF_USE_DUKTAPE := NO
NETSURF_USE_PNG := YES
NETSURF_USE_JPEG := YES
NETSURF_USE_JPEGXL := NO
NETSURF_USE_WEBP := NO
NETSURF_USE_BMP := YES
NETSURF_USE_GIF := YES
NETSURF_USE_NSSVG := NO
NETSURF_USE_RSVG := NO
NETSURF_USE_ROSPRITE := NO
NETSURF_USE_NSPSL := YES
NETSURF_USE_NSLOG := YES
NETSURF_USE_UTF8PROC := YES
NETSURF_USE_LIBICONV_PLUG := NO
NETSURF_USE_HARU_PDF := NO
NETSURF_LOG_LEVEL := INFO
NETSURF_FB_FONTLIB := freetype
NETSURF_FB_RESPATH := sd:/apps/iachannel/netsurf
NETSURF_FB_FONTPATH :=
CFLAGS += -O2
