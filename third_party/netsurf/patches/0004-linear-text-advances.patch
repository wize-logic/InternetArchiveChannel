+/**
+ * The glyph's linear advance (its design width scaled to the font size, without hinting), in
+ * 16.16 pixels. Hinted advances are rounded to whole pixels at each size, so text measured at one
+ * size and drawn at another (zoom) came out wider or narrower than laid out; linear advances
+ * scale exactly. Used for both measuring and plotting.
+ */
+FT_Fixed fb_glyph_advance(const plot_font_style_t *fstyle, uint32_t ucs4);
+
