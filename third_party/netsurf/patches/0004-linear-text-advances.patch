+/* exported interface documented in framebuffer/font_freetype.h */
+FT_Fixed fb_glyph_advance(const plot_font_style_t *fstyle, uint32_t ucs4)
+{
+        FTC_ScalerRec srec;
+        fb_faceid_t *fb_face;
+        FT_Face face;
+        FT_UInt glyph_index;
+        FT_Fixed units;
+
+        fb_fill_scalar(fstyle, &srec);
+        fb_face = (fb_faceid_t *)srec.face_id;
+        if (FTC_Manager_LookupFace(ft_cmanager, srec.face_id, &face) != 0 ||
+            face->units_per_EM == 0)
+                return 0;
+        glyph_index = FTC_CMapCache_Lookup(ft_cmap_cache, srec.face_id,
+                        fb_face->cidx, ucs4);
+        if (FT_Get_Advance(face, glyph_index, FT_LOAD_NO_SCALE, &units) != 0)
+                return 0;
+        /* srec.width is the size in 26.6 points at x_res dpi */
+        return (FT_Fixed)((double)units * srec.width * srec.x_res * 1024.0 /
+                        (72.0 * face->units_per_EM));
+}
